#!/usr/bin/env python3
"""Scoring program for Triangulation Coloring (CodeChef TRICOL)."""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", "src"))
from verifier import Verifier


def main() -> None:
    if len(sys.argv) < 3:
        print("Usage: ./tester <input_file> <output_file>", file=sys.stderr)
        sys.exit(1)

    v = Verifier(sys.argv[1])
    ok, err, score = v.verify(sys.argv[2])
    if not ok:
        print(f"wrong answer: {err}", file=sys.stderr)
        sys.exit(1)
    print(f"Score = {score}", file=sys.stderr)
    sys.exit(0)


if __name__ == "__main__":
    main()
