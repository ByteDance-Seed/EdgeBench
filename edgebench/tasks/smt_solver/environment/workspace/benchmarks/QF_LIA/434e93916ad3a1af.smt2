(set-logic QF_LIA)
(declare-fun x9_plus () Int)
(declare-fun x9_minus () Int)
(declare-fun x8_plus () Int)
(declare-fun x8_minus () Int)
(declare-fun x2_plus () Int)
(declare-fun x2_minus () Int)
(declare-fun x1_plus () Int)
(declare-fun x1_minus () Int)
(declare-fun x7_plus () Int)
(declare-fun x7_minus () Int)
(declare-fun x3_plus () Int)
(declare-fun x3_minus () Int)
(declare-fun x0_plus () Int)
(declare-fun x0_minus () Int)
(declare-fun x6_plus () Int)
(declare-fun x6_minus () Int)
(declare-fun x5_plus () Int)
(declare-fun x5_minus () Int)
(declare-fun x4_plus () Int)
(declare-fun x4_minus () Int)
(assert (>= x9_plus 0))
(assert (>= x9_minus 0))
(assert (>= x8_plus 0))
(assert (>= x8_minus 0))
(assert (>= x2_plus 0))
(assert (>= x2_minus 0))
(assert (>= x1_plus 0))
(assert (>= x1_minus 0))
(assert (>= x7_plus 0))
(assert (>= x7_minus 0))
(assert (>= x3_plus 0))
(assert (>= x3_minus 0))
(assert (>= x0_plus 0))
(assert (>= x0_minus 0))
(assert (>= x6_plus 0))
(assert (>= x6_minus 0))
(assert (>= x5_plus 0))
(assert (>= x5_minus 0))
(assert (>= x4_plus 0))
(assert (>= x4_minus 0))
(assert (<= (+ x9_plus (* (- 1) x9_minus) (* (- 1) x8_plus) x8_minus x2_plus (* (- 1) x2_minus) (* 2 x1_plus) (* (- 2) x1_minus) ) 0 ) )
(assert (<= (+ x7_plus (* (- 1) x7_minus) (* (- 1) x3_plus) x3_minus x2_plus (* (- 1) x2_minus) (* 2 x0_plus) (* (- 2) x0_minus) ) 1 ) )
(assert (>= (+ x6_plus (* (- 1) x6_minus) x5_plus (* (- 1) x5_minus) x3_plus (* (- 1) x3_minus) (* 2 x1_plus) (* (- 2) x1_minus) ) 0 ) )
(assert (>= (+ x4_plus (* (- 1) x4_minus) (* (- 1) x2_plus) x2_minus x1_plus (* (- 1) x1_minus) ) 1 ) )
(assert (>= (+ x7_plus (* (- 1) x7_minus) x2_plus (* (- 1) x2_minus) (* (- 1) x1_plus) x1_minus ) 0 ) )
(check-sat)
(exit)
