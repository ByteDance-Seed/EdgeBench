--- build baseline.so ---
$ make clean && make -j4
rm -f src/codec.o libintcompress.so tools/bench tools/verify
g++ -std=c++17 -O3 -march=x86-64-v3 -Wall -Wextra -Wno-unused-parameter -Iinclude -fPIC -c -o src/codec.o src/codec.cpp
g++ -shared -std=c++17 -O3 -march=x86-64-v3 -Wall -Wextra -Wno-unused-parameter -Iinclude -fPIC -o libintcompress.so src/codec.o
g++ -std=c++17 -O2 -Iinclude -o tools/bench tools/bench.cpp -L. -lintcompress -lpthread -Wl,-rpath,'$ORIGIN/..'
g++ -std=c++17 -O2 -Iinclude -o tools/verify tools/verify.cpp -L. -lintcompress -lpthread -Wl,-rpath,'$ORIGIN/..'
[build ok, 4.2s]

